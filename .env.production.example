# ==============================================================================
# PDFKarlo Platform - Production Environment Variables
# Copy to .env in production and populate all secret keys
# ==============================================================================

# Application & Gateway
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_SECRET_KEY=generate_with_openssl_rand_hex_32
PORT=80
CORS_ORIGINS=["https://yourdomain.com"]

# PostgreSQL 16
POSTGRES_DB=pdf_platform
POSTGRES_USER=pdf_user
POSTGRES_PASSWORD=generate_strong_database_password_here

# Redis 7
REDIS_URL=redis://redis:6379/0

# MinIO / AWS S3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=generate_s3_access_key
S3_SECRET_ACCESS_KEY=generate_s3_secret_key
S3_RAW_BUCKET=pdf-raw-staging
S3_ARTIFACT_BUCKET=pdf-artifacts
S3_FORCE_PATH_STYLE=true

# Quotas, Retention & Deadlines
MAX_FILE_SIZE_BYTES=104857600
MAX_PAGE_COUNT=1000
DOWNLOAD_TOKEN_TTL_SECONDS=900
DOWNLOAD_LEASE_WINDOW_SECONDS=120
RETENTION_HOURS=2
