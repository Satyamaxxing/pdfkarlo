# ==============================================================================
# Global Platform Environment Configuration (.env.example)
# Copy to .env and configure for local or production deployments.
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-secure-random-256-bit-key-in-production

# API Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pdf_platform
POSTGRES_USER=pdf_user
POSTGRES_PASSWORD=pdf_password_secure
DATABASE_URL=postgresql+asyncpg://pdf_user:pdf_password_secure@localhost:5432/pdf_platform

# Redis Configuration (Broker, Cache & Token Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3) Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_RAW_BUCKET=pdf-raw-staging
S3_ARTIFACT_BUCKET=pdf-artifacts
S3_FORCE_PATH_STYLE=true

# Security & Quota Constraints
MAX_FILE_SIZE_BYTES=104857600       # 100 MB max upload ceiling
MAX_PAGE_COUNT=1000                 # Maximum pages admitted
DOWNLOAD_TOKEN_TTL_SECONDS=900      # 15 minutes base lifetime
DOWNLOAD_LEASE_WINDOW_SECONDS=120   # 120 seconds retry lease
RETENTION_HOURS=2                   # 2-hour retention target

# Celery Worker Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=pdf_tasks
